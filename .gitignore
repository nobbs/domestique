# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts. `mise run coverage` writes the
# Go profile and the UI LCOV report under /.coverage; no report is committed.
# The bare `coverage.*` inherited from the Go template is anchored to the root:
# unanchored it also swallowed the UI's own coverage tooling, which is source.
*.out
/coverage.*
*.coverprofile
profile.cov
/.coverage/

# JUnit reports from the three test suites, written by `mise run test`,
# `mise run ui-test` and `mise run ui-browser-test` and uploaded to Codecov's
# test analytics by CI. Nothing here is committed.
/.test-results/

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.*
!.env.example

# Browser UI build output and dependencies. The .gitkeep placeholder stays
# tracked so the go:embed pattern remains valid before the UI has been built.
node_modules/
/.pnpm-store/
/internal/webui/app/dist/*
!/internal/webui/app/dist/.gitkeep
/internal/webui/app/storybook-static/

# Local Domestique state and configuration
/build/
/.cache/
/tmp/
*.db
*.db-shm
*.db-wal
config.toml
config.local.toml
/secrets/
/.local/
.mise.local.toml

# Editor/IDE
# .idea/
# .vscode/

# Browser suite artefacts: traces, failure screenshots and the HTML report a
# failed `mise run ui-browser-test` leaves behind. No image is committed; the suite
# compares a page against itself within a run.
/.playwright/

# Ignore all skills except those that start with "domestique-"
/.agents/skills/*
!/.agents/skills/domestique-*

# `mise run skills-sync` symlinks every fetched skill here; only the
# first-party domestique-* symlinks are committed.
/.claude/skills/*
!/.claude/skills/domestique-*
