{
  "name": "domestique-webui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "description": "Read-only browser UI for the Domestique route map view.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "api:generate": "orval --config orval.config.ts && biome check --write src/api/generated.ts && sed -i.bak 's@pageParam ?? params?\\.\\[\"after\"\\]@(pageParam ?? params?.after) as string@' src/api/generated.ts && rm src/api/generated.ts.bak",
    "storybook": "storybook dev --port 6006",
    "storybook:build": "storybook build",
    "test": "vitest run --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:storybook": "VITEST_JUNIT_SUFFIX=storybook vitest run --project=storybook",
    "test:storybook:sweep": "storybook build --quiet && node sweep-storybook.mjs",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "maplibre-gl": "^6.6.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@chromatic-com/storybook": "5.3.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "orval": "8.27.0",
    "playwright": "1.62.1",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
